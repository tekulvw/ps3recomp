# Optional FFmpeg 9 dependency; callers explicitly opt in.
option(PS3RECOMP_SAIL_FFMPEG "Enable bounded Sail MPEG-2 picture decoding with FFmpeg 9" OFF)
function(ps3recomp_enable_sail_video target)
    if(NOT PS3RECOMP_SAIL_FFMPEG)
        return()
    endif()
    find_path(PS3RECOMP_FFMPEG_INCLUDE_DIR libavcodec/avcodec.h)
    foreach(component AVCODEC AVFORMAT AVUTIL SWSCALE)
        string(TOLOWER "${component}" name)
        find_library(PS3RECOMP_FFMPEG_${component}_LIBRARY NAMES ${name})
        if(NOT PS3RECOMP_FFMPEG_${component}_LIBRARY)
            message(FATAL_ERROR "Sail FFmpeg enabled but ${name} library was not found; set PS3RECOMP_FFMPEG_${component}_LIBRARY")
        endif()
        target_link_libraries(${target} PRIVATE "${PS3RECOMP_FFMPEG_${component}_LIBRARY}")
    endforeach()
    if(NOT PS3RECOMP_FFMPEG_INCLUDE_DIR)
        message(FATAL_ERROR "Sail FFmpeg enabled but public headers were not found; set PS3RECOMP_FFMPEG_INCLUDE_DIR")
    endif()
    target_include_directories(${target} PRIVATE "${PS3RECOMP_FFMPEG_INCLUDE_DIR}")
    target_compile_definitions(${target} PRIVATE PS3RECOMP_SAIL_FFMPEG=1)
endfunction()
